{
  "env": {
    "DREDD_URL": "https://dredd-hook.acta.io"
  },
  "enabledPlugins": {},
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "model": "claude-fable-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adrian/IdeaProjects/JudgeAIDredd/hooks/dredd-hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
