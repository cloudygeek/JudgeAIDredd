{
  "env": {
    "DREDD_URL": "https://judge-ai-dredd-server.aisandbox.dev.ckotech.internal"
  },
  "model": "global.anthropic.claude-opus-4-7[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DREDD_MODE=interactive ${HOME}/.claude/dredd/dredd-hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "security@cko-core-platform-cko-plugins": true,
    "requirements@cko-core-platform-cko-plugins": true,
    "sre@cko-core-platform-cko-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "platform@cko-core-platform-cko-plugins": true,
    "architecture@cko-core-platform-cko-plugins": true,
    "frontend@cko-core-platform-cko-plugins": true,
    "code-review@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cko-data-platform-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "cko-data-platform/claude-plugins"
      }
    },
    "cko-core-platform-cko-plugins": {
      "source": {
        "source": "github",
        "repo": "cko-core-platform/cko-plugins"
      }
    }
  },
  "theme": "dark"
}
