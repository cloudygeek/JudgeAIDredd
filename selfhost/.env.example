# Copy to `.env` (gitignored) inside the VM and fill in.
#   cp .env.example .env && chmod 600 .env

# ---- hostnames -------------------------------------------------------------
HOOK_HOST=hook.soteriacyber.com
DASHBOARD_HOST=dredd.soteriacyber.com
ACME_EMAIL=you@example.com

# ---- the macOS host's Ollama ----------------------------------------------
# The host-side address of the VM's shared network, NOT 0.0.0.0 and NOT the
# Studio's LAN address. Find it with the recipe in README.md ("Point the VM at
# the host's Ollama") and verify from inside the VM before starting the stack.
# Binding Ollama to 0.0.0.0 would publish an unauthenticated model endpoint to
# your whole LAN.
OLLAMA_HOST=http://192.168.105.1:11434

JUDGE_MODEL=qwen3.6
EMBEDDING_MODEL=nomic-embed-text

# interactive | autonomous | learn
# Keep `interactive` while soaking. With DREDD_JUDGE_FAIL_CLOSED=true, an Ollama
# outage in `interactive` degrades to "the user is asked"; in `autonomous` it
# hard-blocks every tool call until inference is back.
MODE=interactive

# ---- AWS: the dredd-selfhost IAM user, DynamoDB-only -----------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMO_REGION=eu-west-1

# ---- Clerk (dashboard) -----------------------------------------------------
# The dashboard returns 503 on every /api/* without CLERK_SECRET_KEY.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: static PEM/JWK so the container never needs to reach api.clerk.com
# for JWKS. Useful if egress is restricted.
CLERK_JWT_PUBLIC_KEY=

# ---- build provenance ------------------------------------------------------
# Set at deploy time: GIT_COMMIT=$(git rev-parse --short HEAD)
GIT_COMMIT=
