node_modules/
dist/
*.js.map
logs/
openapi.key
hf.key
dredd.key
bedrock.key

# Local dev secrets — Clerk + AWS overrides for `npm run server` etc.
# NEVER commit. Sandbox/Fargate gets these from SSM, not files.
.env
.env.local
.env.*.local
.venv/
__pycache__/
.DS_Store
log.txt

# Container build artefacts — produced by `mkdir /tmp/dredd-rezip-* && zip` flow,
# never committed (CodeBuild rebuilds the image from src/ on every push).
judge-ai-dredd-*.zip

# Cast harness — recordings are large and regeneratable, and the
# harness/configs/ tree is a synthesised ~/.claude home dir seeded from
# the operator's real one: api-keys, .credentials.json, .claude.json,
# history.jsonl, OAuth state. This is an ALLOWLIST on purpose — the old
# denylist form missed .credentials.json, and a new secret-bearing file
# appearing in ~/.claude would have silently become committable. Only
# settings.json (the thing that actually differs between the two arms)
# is tracked.
harness/casts/
harness/run-workspace/
harness/configs/*/**
!harness/configs/*/settings.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform / OpenTofu runtime artefacts
terraform/.terraform/
terraform/tfplan
terraform/*.tfplan
terraform/*.tfstate
terraform/*.tfstate.backup

# Claude Code scheduler lock — machine-local runtime artefact.
.claude/scheduled_tasks.lock

# Per-session log dumps. Session state is Dynamo-backed in prod; these
# on-disk JSONs are local-dev artefacts (the dashboard reads them only as
# a legacy fallback) and accumulate fast — results/ is already multi-GB.
results/session-*.json
