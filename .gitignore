node_modules/
dist/
*.js.map
logs/
openapi.key
hf.key

# Local dev secrets — Clerk + AWS overrides for `npm run server` etc.
# NEVER commit. Sandbox/Fargate gets these from SSM, not files.
.env
.env.local
.env.*.local
.venv/
__pycache__/
.DS_Store
log.txt

# Container build artefacts — produced by `mkdir /tmp/dredd-rezip-* && zip` flow,
# never committed (CodeBuild rebuilds the image from src/ on every push).
judge-ai-dredd-*.zip

# Cast harness — recordings are large and regeneratable, and the
# harness/configs/ tree is a synthesised ~/.claude home dir that
# will pull in real api-keys, .claude.json, history.jsonl, and the
# CKO CA bundle on every run. Only the settings.json files are
# safe (and useful) to track.
harness/casts/
harness/configs/*/api-key
harness/configs/*/.claude.json
harness/configs/*/.last-cleanup
harness/configs/*/history.jsonl
harness/configs/*/settings.enabled
harness/configs/*/cko-ca-bundle.pem
harness/configs/*/mcp-needs-auth-cache.json
harness/configs/*/cache/
harness/configs/*/plugins/
harness/configs/*/dredd/
harness/configs/*/projects/
harness/configs/*/backups/
harness/configs/*/file-history/
harness/configs/*/telemetry/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
