# Judge AI Dredd — Standalone Judge Server
# Lightweight image for vibe coders: just the HTTP server + dashboard.
# No Python, Playwright, PostgreSQL, or test harness.
#
# Build from project root:
#   docker build -f fargate/Dockerfile.judge -t judge-ai-dredd-judge .
#
# Run:
#   docker run -p 3000:3000 \
#     -v judge-data:/data \
#     -e MODE=interactive \
#     -e BACKEND=bedrock \
#     -e AWS_REGION=eu-west-2 \
#     judge-ai-dredd-judge

# Public Docker Hub base. This deliberately does NOT use the
# cko-pull-through ECR mirror the Fargate images use: that registry lives in
# a different AWS account, so anyone self-hosting this image outside that org
# cannot authenticate to pull it.
FROM node:22-bookworm-slim

WORKDIR /app

# ── No AWS CLI ──────────────────────────────────────────────────────────────
# Every AWS call goes through the SDK (@aws-sdk/client-bedrock-runtime,
# @aws-sdk/client-dynamodb). Nothing in src/ shells out to `aws`, so the
# ~150MB CLI install this image used to carry was dead weight. The zip-based
# Fargate images already dropped it; this one had not caught up.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Node dependencies ───────────────────────────────────────────────────────
COPY package.json package-lock.json ./
# npm ci against the committed lockfile — deterministic. A bare
# `npm install` here resolved fresh AWS-SDK publishes mid-propagation
# (lib-dynamodb's peer wanting a client-dynamodb the registry didn't
# serve yet) and broke the 2026-08-27 deploy. The lockfile is the fix,
# not a retry.
RUN npm ci --registry https://registry.npmjs.org

# ── Application source (server + dashboard only) ───────────────────────────
COPY tsconfig.json ./
COPY src/ ./src/
# hooks/ is a RUNTIME dependency, not just build tooling: src/hook-bake.ts reads
# hooks/dredd-hook.sh and hooks/dredd-managed-allow.sh to bake the client hook
# served by GET /api/hook-script and the dashboard's integration bundle. Without
# it those endpoints throw ENOENT — this image shipped without them.
COPY hooks/ ./hooks/

# ── Build provenance ────────────────────────────────────────────────────────
ARG GIT_COMMIT=unknown
ARG GIT_DIRTY=false
ENV GIT_COMMIT=${GIT_COMMIT}
ENV GIT_DIRTY=${GIT_DIRTY}

# ── Data volume mount point ─────────────────────────────────────────────────
# EFS mounts at /data. Sessions go to /data/sessions, console logs to /data/logs.
RUN mkdir -p /data/sessions /data/logs

# ── Entrypoint ──────────────────────────────────────────────────────────────
COPY fargate/docker-entrypoint-judge.sh /docker-entrypoint-judge.sh
RUN chmod +x /docker-entrypoint-judge.sh

# ── Non-root user ───────────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash dredd \
    && chown -R dredd:dredd /app /data
USER dredd

EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint-judge.sh"]
