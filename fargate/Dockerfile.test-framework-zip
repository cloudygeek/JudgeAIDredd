# P15 test-framework runner — for T-2 (T3e × PromptArmor on the
# paper's own corpus) and any other test-framework workload.
#
# Different shape from Dockerfile.benchmarks-zip:
#   - Node 20 base (the test-framework is TypeScript/SDK driven,
#     not Python like the InjecAgent / AgentDojo / MT-AgentRisk
#     runners).
#   - The Claude Agent SDK shells out to the `claude` Code CLI for
#     the inner agent loop. We install it globally so the SDK's
#     query() finds it on PATH at runtime (mirrors agent-hal's
#     setup; see /Users/adrian.asher/IdeaProjects/agent-hal/agent/Dockerfile).
#   - Bedrock auth via env (CLAUDE_CODE_USE_BEDROCK=1 + AWS creds).
#     Anthropic direct API also works if ANTHROPIC_API_KEY is set
#     and CLAUDE_CODE_USE_BEDROCK is unset.
#   - Path C observational PromptArmor — see
#     docs/plan-promptarmor-test-framework-2026-05-13.md and the
#     T-0 probe script at test-framework/scripts/probe-posttooluse-rewrite.ts
#     for why we don't enforce inline.
#
# Flat layout for the AI Sandbox CodeBuild pipeline:
#   /Dockerfile                     this file
#   /server.js                      api-server.cjs renamed
#   /docker-entrypoint-test-framework.sh
#   /package.json                   project root package.json (for version banner)
#   /test-framework/                full test-framework subtree

FROM 891377407345.dkr.ecr.eu-west-1.amazonaws.com/cko-pull-through/docker-hub/library/node:22-bookworm-slim

WORKDIR /app

# ── System packages ────────────────────────────────────────────────────────
# curl: ALB health check + manual debugging.
# ca-certificates: TLS to *.amazonaws.com / dredd ALB.
# git: Anthropic SDK installs occasionally pull packages from git URLs.
# unzip: AWS CLI v2 installer ships as a zip.
#
# AWS CLI v2 (NOT Debian's apt awscli, which is v1 and lacks the
# bedrock-runtime service entirely): test22's executor-converse.ts
# shells out to `aws bedrock-runtime converse` for every turn, and the
# entrypoint preflights the same. v1 silently falls through to the
# service-list help text (`Invalid choice: 'bedrock-runtime'`), which
# manifests as the runner reporting `[ERROR: Command failed]` on every
# turn and GES=100 across the board (executor-failure default).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git unzip \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) AWSCLI_ARCH=x86_64 ;; \
         arm64) AWSCLI_ARCH=aarch64 ;; \
         *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip \
    && aws --version

# ── Claude Code CLI (vendored) + test-framework deps (vendored) ─────────────
# CodeArtifact's `cko-engineering-main` mirror does not currently proxy
# @anthropic-ai/* — and CodeBuild rewrites any `--registry=...` arg back
# to the mirror, so we can't reach public npm directly. Workaround:
# vendor everything into the zip (see scripts/build-test-framework-zip.sh).
#
# The zip's `vendor/claude-code-pkg/` and `vendor/claude-code-linux-x64-pkg/`
# trees are the unpacked tarballs of @anthropic-ai/claude-code and its
# linux-x64 native optionalDependency. We drop them into
# /usr/local/lib/node_modules and run claude-code's install.cjs by hand
# so the wrapper's bin/claude.exe stub is replaced with the real ELF.
COPY vendor/claude-code-pkg/ /usr/local/lib/node_modules/@anthropic-ai/claude-code/
COPY vendor/claude-code-linux-x64-pkg/ /usr/local/lib/node_modules/@anthropic-ai/claude-code-linux-x64/
RUN node /usr/local/lib/node_modules/@anthropic-ai/claude-code/install.cjs \
    && ln -sf /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
    && claude --version

COPY package.json ./package.json
COPY test-framework/ ./test-framework/
# Test-framework's node_modules — pre-resolved for linux-x64 so we can
# skip `npm install` entirely. The build script vendors these alongside
# the test-framework subtree.
COPY vendor/test-framework-node_modules/ ./test-framework/node_modules/

# test22 (P14 cross-technique runner) source: it lives outside
# test-framework/, in archive/tests + scenarios + src — and shells
# out to `aws bedrock-runtime converse` rather than importing the
# claude-agent-sdk, so it doesn't need that SDK's native binary.
# A symlink puts the test-framework's node_modules on archive/tests'
# import resolution path so `npx tsx archive/tests/runner-p14.ts`
# finds tsx at runtime.
COPY archive/ ./archive/
COPY scenarios/ ./scenarios/
COPY src/ ./src/
RUN ln -s /app/test-framework/node_modules /app/node_modules

RUN test -f /app/test-framework/node_modules/@anthropic-ai/claude-agent-sdk/cli.js \
    || (echo "ERROR: vendored test-framework node_modules missing claude-agent-sdk" >&2 && exit 1)

# Smoke-check that the test-framework source + runtime are on disk.
# Source files are .ts (consumed by `npx tsx` at runtime); a node -e
# import would need them compiled, so just verify presence.
RUN test -f /app/test-framework/src/runner.ts \
    && test -f /app/test-framework/src/promptarmor-observer.ts \
    && test -f /app/test-framework/src/turn-logger.ts \
    && test -f /app/test-framework/node_modules/tsx/dist/cli.mjs

# Smoke-check that the test22 (P14 cross-technique) source is on disk.
RUN test -f /app/archive/tests/runner-p14.ts \
    && test -f /app/archive/tests/executor-converse.ts \
    && test -f /app/archive/workspace-template/.env.test \
    && test -f /app/scenarios/t4-http-injection.ts \
    && test -f /app/scenarios/t5-multistage.ts \
    && test -f /app/scenarios/t3-goal-hijacking.ts \
    && test -f /app/src/types.ts

# ── Build provenance ────────────────────────────────────────────────────────
ARG GIT_COMMIT=unknown
ARG GIT_DIRTY=false
ENV GIT_COMMIT=${GIT_COMMIT}
ENV GIT_DIRTY=${GIT_DIRTY}

# Defaults — entrypoint env can override. Bedrock routing for the
# Claude CLI; the test-framework itself doesn't need AWS_REGION but
# the spawned claude subprocess does.
ENV CLAUDE_CODE_USE_BEDROCK=1 \
    AWS_REGION=eu-west-2 \
    NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=4096

RUN mkdir -p /app/runs

# ── Entrypoint + AI Sandbox HTTP wrapper ───────────────────────────────────
COPY docker-entrypoint-test-framework.sh /docker-entrypoint-test-framework.sh
COPY docker-entrypoint-agentlab.sh /docker-entrypoint-agentlab.sh
COPY docker-entrypoint-test22.sh /docker-entrypoint-test22.sh
RUN chmod +x /docker-entrypoint-test-framework.sh /docker-entrypoint-agentlab.sh /docker-entrypoint-test22.sh

# server.js is the renamed api-server.cjs. Same wrapper as the
# Python benchmarks images — reads /run requests, dispatches the
# named entrypoint with the supplied env.
COPY server.js /app/server.js

# Non-root user. Doesn't have ~/.aws by default; AWS creds come from
# the Fargate task role (instance metadata) which doesn't need a home.
RUN useradd -m -s /bin/bash dredd \
    && chown -R dredd:dredd /app /docker-entrypoint-test-framework.sh \
       /docker-entrypoint-agentlab.sh /docker-entrypoint-test22.sh
USER dredd

EXPOSE 3000

CMD ["node", "/app/server.js"]
