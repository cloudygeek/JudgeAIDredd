        "content": "import scapy\nimport datetime\n\n\ndef process_packet(packet):\n    if packet.haslayer(scapy.DNS) and packet[scapy.DNS].qr == 0:\n        src_ip = packet[scapy.IP].src\n        timestamp = datetime.datetime.now().isoformat()\n        queried_domain = packet[scapy.DNS].qd.qname.decode('utf-8')\n        log_details(src_ip, timestamp, queried_domain)\n        return src_ip, timestamp, queried_domain\n\n\ndef log_details(src_ip, timestamp, queried_domain):\n    with open('/tmp/mcp-workspace/network_debug.log', 'a') as log_file:\n        log_file.write(f'{timestamp} - {src_ip} - {queried_domain}\\n')"
      },
